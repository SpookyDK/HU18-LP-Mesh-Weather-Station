<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Sensor Viewer</title><style>
body{font:13px monospace;margin:8px}table{border-collapse:collapse;font:12px monospace}
th,td{border:1px solid #222;padding:2px 4px;white-space:nowrap}th{cursor:pointer;background:#444}
input,select{font:12px monospace;padding:2px}button{font:12px monospace;padding:2px 6px}
#s{font-weight:bold}</style>
<meta name="color-scheme" content="light dark"/></head><body>
<b>Sensor Viewer</b> &nbsp;
<span id="s">Connecting...</span><br><br>
Node:<input id="fn" size="4" oninput="render()">Flag:<input id="ff" size="8" oninput="render()">
Max:<select id="mr" onchange="render()"><option>100</option><option>200</option><option>500</option><option>0</option></select>
<button onclick="idx=0;rows=[];render()">Clear</button><button onclick="ws.send('START_SD_STREAM:'+idx);render()">Get New</button>
<button onclick="exportCSV()">CSV</button>
&nbsp;<span id="cnt"></span>
<div style="display: flex; align-items: flex-start; gap: 10px; margin-top: 6px;">
<div style="overflow-x:auto;flex-shrink:0;"><table><thead><tr>
<th onclick="sort('t')">Time</th><th onclick="sort('orig_node_id')">Node</th><th onclick="sort('packet_id')">PktID</th>
<th onclick="sort('hop_count')">Hops</th><th onclick="sort('latitude')">Lat</th><th onclick="sort('longitude')">Lon</th>
<th onclick="sort('air_temp')">Temp°C</th><th onclick="sort('air_humidity')">Hum%</th><th onclick="sort('pressure')">hPa</th>
<th onclick="sort('soil_moisture')">SoilM</th><th onclick="sort('soil_temps')">SoilT°C</th>
<th onclick="sort('lux')">Lux</th><th onclick="sort('precipitation')">Precip</th><th onclick="sort('wind_speed')">Wind</th>
<th onclick="sort('solar_output')">Gen mA</th><th onclick="sort('bat_voltage')">Bat V</th><th onclick="sort('flags')">Flags</th>
</tr></thead><tbody id="tb"></tbody></table></div>
<div style="flex-grow:1;min-width:0;">
<video style="width:100%;height:auto;display:block;" autoplay muted loop>
<source src="https://media.tenor.com/lHUl-0nKsmUAAAPo/cocio-rolling.mp4" type="video/mp4"></video>
<!-- <iframe style="width:100%;height:100vh;display:block;" src="https://www.youtube.com/embed/zZ7AimPACzc?autoplay=1&mute=1&loop=1&controls=0"></iframe> -->
</div></div>
<script>
var rows=[],sc='t',sd='d';
function pp(buf){
var v=new DataView(buf),o=0,r={};
r.network_id=v.getUint8(o++);r.orig_node_id=v.getUint8(o++);
r.packet_id=v.getUint8(o++);;r.hop_count=v.getUint8(o++);r.flags=v.getUint8(o++);
r.longitude=v.getInt32(o,1)/1e7;o+=4;r.latitude=v.getInt32(o,1)/1e7;o+=4;
r.air_humidity=v.getUint8(o++);r.air_temp=v.getInt16(o,1)/10;o+=2;
r.soil_temps=[];for(var i=0;i<4;i++){r.soil_temps.push(v.getInt16(o,1)/16);o+=2;}
r.soil_moisture=v.getUint8(o++);r.pressure=(v.getInt16(o,1)+100000)/100;o+=2;
r.lux=v.getUint16(o,1);o+=2;r.precipitation=v.getUint16(o,1)/10;o+=2;
r.wind_speed=v.getUint16(o,1)/1000;o+=2;
r.solar_output=v.getUint8(o++)*4;r.bat_voltage=v.getUint8(o)/250+3.5;
return r;}
function handleData(b){const v=new DataView(b);let po=0;
while(po<b.byteLength){const t=v.getInt32(po,true)*1000,
c=v.getUint8(po+4);po+=5;for(let i=0;i<c;i++){
const p=pp(b.slice(po,po+@FULL_PACKET@));p.t=t;rows.push(p);
po+=@FULL_PACKET@;}}render();}
function sort(c){if(sc===c)sd=sd==='d'?'a':'d';else{sc=c;sd='d';}render();}
function render(){
var fn=document.getElementById('fn').value;
var ff=document.getElementById('ff').value;
var mr=parseInt(document.getElementById('mr').value)||Infinity;
var col=sc,dir=sd,r=rows.slice();
if(fn)r=r.filter(function(x){return String(x.orig_node_id).indexOf(fn)>=0;});
if(ff)r=r.filter(function(x){return String(x.flags.toString(2).padStart(8,"0")).indexOf(ff.startsWith("0b")?ff.slice(2):ff)>=0;});
r.sort(function(a,b){var av=a[col],bv=b[col];return av<bv?(dir==='a'?-1:1):av>bv?(dir==='a'?1:-1):0;});
if(mr!==Infinity)r=r.slice(0,mr);
document.getElementById('cnt').textContent=rows.length+' rows';
if(!r.length){document.getElementById('tb').innerHTML='<tr><td colspan="15">No data</td></tr>';return;}
document.getElementById('tb').innerHTML=r.map(function(x){
return'<tr><td>'+new Date(x.t).toLocaleString()+'</td><td>'+x.orig_node_id+'</td><td>'+x.packet_id+'</td><td>'+x.hop_count+'</td>'+
'<td>'+x.latitude.toFixed(7)+'</td><td>'+x.longitude.toFixed(7)+'</td>'+
'<td>'+x.air_temp.toFixed(1)+'</td><td>'+x.air_humidity+'</td><td>'+x.pressure.toFixed(1)+'</td>'+
'<td>'+x.soil_moisture+'</td><td>'+x.soil_temps.map(function(t){return t.toFixed(1);}).join('/')+'</td>'+
'<td>'+x.lux+'</td><td>'+x.precipitation.toFixed(1)+'</td><td>'+x.wind_speed.toFixed(3)+'</td>'+
'<td>'+x.solar_output+'</td><td>'+x.bat_voltage.toFixed(2)+'</td>'+
'<td>0b'+x.flags.toString(2).padStart(8,'0')+'</td></tr>';}).join('');
}
function exportCSV(){
if(!rows.length)return;
var h='time,node,network,packet_id,hops,flags,lat,lon,air_temp,humidity,pressure,soil_moist,soil_t1,soil_t2,soil_t3,soil_t4,lux,precip,wind\n';
var b=rows.map(function(r){return[new Date(r.t).toISOString(),r.orig_node_id,r.network_id,r.packet_id,r.hop_count,'0x'+r.flags.toString(16),r.latitude,r.longitude,r.air_temp,r.air_humidity,r.pressure,r.soil_moisture].concat(r.soil_temps).concat([r.lux,r.precipitation,r.wind_speed,r.solar_output,r.bat_voltage]).join(',');}).join('\n');
var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([h+b],{type:'text/csv'}));
a.download='sensors.csv';a.click();
}
var ws,idx=0,heartbeatTimer;
function resetHeartbeat(){
clearTimeout(heartbeatTimer);
heartbeatTimer = setTimeout(()=>{
console.warn("Heartbeat lost. Closing Conn");
if (ws) ws.close(); },10000); }
function conn(){
document.getElementById('s').textContent='Connecting...';
ws=new WebSocket('ws://'+location.hostname+'/dataviewer');
ws.binaryType='arraybuffer';
ws.onopen=function(){document.getElementById('s').textContent='Connected';ws.send(idx?'START_SD_STREAM:'+idx:'START_SD_STREAM');};
ws.onclose=function(){document.getElementById('s').textContent='Disconnected';setTimeout(conn,2000);};
ws.onmessage=function(e){
if(e.data instanceof ArrayBuffer){handleData(e.data);}
    else if(e.data.startsWith('END_OF_TRANSMISSION')){idx=Number(e.data.split(':')[1]);}
    else{console.log("Received unkown packet:"+e)}
};}conn();
</script></body></html>
