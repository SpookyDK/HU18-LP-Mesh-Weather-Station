CM 868 MHz Rubber Duck - Corner Mount Inline
CE
# --- ANTENNA (Top-Left Corner) ---
# 5cm wire starting at the corner
GW 1 15 -0.045 0 0.001 -0.045 0 0.051 0.00075
# --- PROTOBOARD (9cm Wide x 7cm Down) ---
# Horizontal Wires (X-axis, 9cm total)
GW 2 9 -0.045 0 0      0.045 0 0      0.0005
GW 3 9 -0.045 0 -0.035 0.045 0 -0.035 0.0005
GW 4 9 -0.045 0 -0.07  0.045 0 -0.07  0.0005
# Vertical Wires (Z-axis, 7cm total)
GW 5 7 -0.045 0 0     -0.045 0 -0.07  0.0005
GW 6 7  0.000 0 0      0.000 0 -0.07  0.0005
GW 7 7  0.045 0 0      0.045 0 -0.07  0.0005
GE 0
# --- MATERIAL & COIL ---
LD 5 1 0 0 3.72E7
# Inductor (Tuned for corner impedance)
LD 0 1 1 1 1.5 3.8E-7 0
# --- FEED ---
EX 0 1 1 0 1 0
FR 0 100 0 0 800 1
RP 0 181 73 1000 0.5 0 1 5
EN
